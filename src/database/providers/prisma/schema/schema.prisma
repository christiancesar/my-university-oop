generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model University {
  id          String       @id @default(uuid())
  name        String       @unique()
  address_id  String?
  disciplines Discipline[]
  address     Address?     @relation(fields: [address_id], references: [id], onDelete: Cascade)

  @@map("universities")
}
