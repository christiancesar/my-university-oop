model Address {
  id           String       @id @default(uuid())
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  country      String
  zipcode      String
  university   University[]
  created_at   DateTime     @default(now())
  updated_at   DateTime     @updatedAt

  @@map("addresses")
}
