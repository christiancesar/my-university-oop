{
  "name": "my-university",
  "description": "Create my manager university",
  "version": "1.0.0",
  "main": "./src/server.ts",
  "keywords": [
    "nodejs",
    "typescript",
    "ts-node",
    "swc",
    "express"
  ],
  "author": "ccrs",
  "type": "module",
  "scripts": {
    "dev": " bun --watch src/server.ts",
    "prisma:migrate:dev": "prisma migrate dev",
    "builder": "bun ./build.js",
    "start:bun": "bun ./dist/server.js",
    "start:node": "node ./dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:cov": "vitest run --coverage"
  },
  "prisma": {
    "schema": "src/database/providers/prisma/schema",
    "seed": "tsx src/database/providers/prisma/seed.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.2.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@faker-js/faker": "^9.6.0",
    "@prisma/client": "^6.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "prisma": "^6.5.0",
    "zod": "^3.24.2"
  },
  "private": true
}
